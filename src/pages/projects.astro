---
import Layout from '../layouts/Layout.astro';
---

<Layout title="最新案件一覧 | 高還元案件多数">
  <main class="bg-slate-50 min-h-screen pb-20">
    <div class="bg-slate-900 py-16 md:py-10 px-6">
      <div class="max-w-5xl mx-auto text-center md:text-left">
        <h1 class="text-sm font-bold text-yellow-500 tracking-[0.3em] uppercase mb-4">Available Projects</h1>
        <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight">
          最新案件一覧
        </h2>
        <p class="text-slate-400 mt-6 max-w-2xl leading-relaxed mx-auto md:mx-0">
          SBTが保有する案件の一部を公開しています。商流の浅い直案件・エンド案件を中心に、エンジニアの正当な評価を約束するプロジェクトのみを厳選しています。
        </p>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-6 py-12 md:py-16">
      <div id="project-list-container" class="grid gap-10">
        <p class="text-center text-slate-500">案件情報を読み込み中...</p>
      </div>

      <section class="mt-16 md:mt-24">
        <div class="bg-slate-900 rounded-2xl p-8 md:p-16 text-center shadow-2xl overflow-hidden relative">
          <div class="absolute top-0 right-0 w-32 h-32 bg-yellow-500/10 rounded-full -mr-16 -mt-16 blur-3xl"></div>
          <div class="absolute bottom-0 left-0 w-32 h-32 bg-blue-500/10 rounded-full -ml-16 -mb-16 blur-3xl"></div>

          <div class="relative z-10 max-w-2xl mx-auto">
            <h3 class="text-2xl md:text-3xl font-black text-white mb-6 leading-tight">
              表示されている案件は<br class="md:hidden" /><span class="text-yellow-500">ほんの一部</span>です
            </h3>
            <p class="text-slate-400 leading-relaxed mb-10 text-sm md:text-base">
              SBTでは、Web上には公開できない「高単価・フルリモート・最新技術」の非公開案件を多数保有しています。
              すべての案件情報の閲覧や、ご希望にマッチした案件の優先案内をご希望の方は、ぜひフリーランス登録をお願いいたします。
            </p>
            
            <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
              <a 
                href="https://member.sbt-inc.co.jp/register" 
                class="inline-flex items-center justify-center gap-3 bg-yellow-500 text-slate-900 font-black px-10 py-5 rounded-xl hover:bg-white transition-all duration-300 w-full md:w-auto shadow-xl shadow-yellow-500/20"
              >
                フリーランス登録（無料）
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>
            
            <p class="text-slate-500 text-[11px] mt-6 italic">
              ※登録後、担当エージェントより面談のご案内を差し上げます。
            </p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    // --- 最新案件の読み込みと描画処理 ---
    async function loadProjects() {
      const container = document.getElementById('project-list-container');
      try {
        const res = await fetch('/projects.json?v=' + Date.now());
        let projects = await res.json();

        if (container && projects.length > 0) {
          
          // 1. 必要な項目がnullでないものを抽出
          const filtered = projects.filter(p => 
            p.reward !== null && 
            p.location !== null && 
            p.skills !== null && 
            p.summary_text !== null
          );

          // 2. created の新しい順に並び替え
          filtered.sort((a, b) => new Date(b.created) - new Date(a.created));

          // 3. 最大10件をピックアップ
          const topTen = filtered.slice(0, 10);

          if (topTen.length === 0) {
            container.innerHTML = '<p class="text-center text-slate-500">現在、公開可能な案件はございません。</p>';
            return;
          }

          container.innerHTML = topTen.map(p => {
            const skillArray = p.skills ? p.skills.split(',').filter(s => s.trim() !== "") : [];
            const displayPrice = `～${p.reward}万`;
            const dateStr = p.created ? p.created.split(' ')[0].split('-').slice(1).join('/') : '';

            return `
            <div class="bg-white border border-slate-300 rounded-lg p-6 md:p-8 shadow-md hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 group">
              <div class="mb-4 text-left flex items-center">
                <span class="inline-block bg-[#004a99] text-white text-[10px] font-bold px-3 py-1 rounded">
                  NEW
                </span>
                <span class="ml-2 text-[10px] text-slate-400 font-medium">
                  (${dateStr})
                </span>
              </div>
              <h3 class="text-xl md:text-2xl font-bold text-[#004a99] mb-6 leading-snug group-hover:text-yellow-600 transition-colors duration-300">
                ${p.title}
              </h3>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-0 border border-slate-200 rounded-md overflow-hidden mb-6">
                <div class="bg-slate-50 p-4 border-b md:border-b-0 md:border-r border-slate-200">
                  <p class="text-[10px] font-bold text-slate-400 mb-1 tracking-wider uppercase">勤務形態</p>
                  <p class="text-[13px] font-bold text-slate-700">${p.remote || '確認中'}</p>
                </div>
                <div class="bg-slate-50 p-4 border-b md:border-b-0 md:border-r border-slate-200">
                  <p class="text-[10px] font-bold text-slate-400 mb-1 tracking-wider uppercase">場所</p>
                  <p class="text-[13px] font-bold text-slate-700 leading-snug">${p.location}</p>
                </div>
                <div class="bg-slate-50 p-4">
                  <p class="text-[10px] font-bold text-slate-400 mb-1 tracking-wider uppercase">想定単価</p>
                  <p class="text-lg font-black text-[#d00000] tracking-tight">${displayPrice}</p>
                </div>
              </div>

              <div class="mb-8">
                <p class="text-[10px] font-black text-slate-400 mb-2 tracking-tighter italic">≪ 案件概要 ≫</p>
                <p class="text-[14px] text-slate-600 leading-relaxed pl-1">
                  ${p.summary_text}
                </p>
              </div>

              <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-100">
                ${skillArray.map(skill => `
                  <span class="bg-[#eef4ff] text-[#004a99] border border-[#cce0ff] px-3 py-1 rounded-full text-[11px] font-bold">
                    ${skill.trim()}
                  </span>
                `).join('')}
              </div>

              <div class="mt-8 flex justify-end">
                <a 
                  href="/contact" 
                  class="text-sm font-bold text-[#004a99] hover:text-yellow-600 flex items-center gap-1 transition-colors"
                >
                  この案件を詳しく聞く
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                  </svg>
                </a>
              </div>
            </div>
            `}).join('');
        }
      } catch (e) {
        console.error(e);
        if (container) container.innerHTML = '<p class="text-center text-slate-500">案件情報の取得に失敗しました。</p>';
      }
    }

    loadProjects();
  </script>
</Layout>